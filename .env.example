# Copie para `.env` (ou exporte as variáveis) antes do `docker compose up`
# se quiser mudar algo. Todos os valores têm padrão — o compose funciona sem.

# Porta única publicada na rede local (escolha uma porta livre).
APP_PORT=3999

# Credenciais do PostgreSQL (só usadas dentro do Docker).
POSTGRES_USER=ondejoga
POSTGRES_PASSWORD=ondejoga
POSTGRES_DB=ondejoga

# 1 = API pode buscar dados externos; 0 = modo só-com-backup-local (offline).
ALLOW_NETWORK=1

# Cache do dashboard agregado (segundos) e TTL padrão por fonte.
DASHBOARD_CACHE_TTL=60
DEFAULT_CACHE_TTL=300

# Origens permitidas na API (separadas por vírgula).
CORS_ORIGINS=*
